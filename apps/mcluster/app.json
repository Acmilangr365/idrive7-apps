{
  "id": "mcluster",
  "title": "M Cluster",
  "description": "Puts the charge gauge and the drive-mode label back on the M cluster layout of a plug-in hybrid: the stock gauge's shape at the bottom right, filled from the car's own charge reading, and the mode below it, with an estimate of the electric range learned from how the car is driven.",
  "version": "0.9.52",
  "vendor": "custom",
  "loggingId": "OAB1",
  "iconGlyph": "battery",
  "mguHmi": [
    "ID7"
  ],
  "autostart": true,
  "signals": {
    "de.bmw.infotainment.drivingexcitement.Efficiencytainment2": {
      "_optional": "the charge gauge: without it the gauge stays empty",
      "statusChargeOfBatteryHybrid": "rs",
      "statusPowerRelativHybrid": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "the drive-mode label",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    },
    "de.bmw.infotainment.climate.Climate2": {
      "_optional": "the A/C compressor's power, part of the consumption while standing",
      "statusActualValuePowerACCompressor": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_optional": "the range estimate: distance comes from the speed",
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "the car switched off: the layers are dropped",
      "VehicleCondition": "s"
    },
    "de.bmw.infotainment.KombiIF": {
      "_optional": "the trip distance and the average electric consumption the stock widget shows",
      "statusBordcomputerTravelData": "rs",
      "statusConsumptionAverageElectricVehicle": "rs",
      "statusRangeTankStatus": "rs",
      "statusBordcomputerAverage": "rs",
      "statusDisplayElectricalPowerDistribution": "rs",
      "statusBordcomputerElectricData": "rs",
      "statusBordcomputerStatus2": "rs",
      "statusBordcomputerTravelStart": "rs"
    },
    "de.bmw.infotainment.resetlogic.ResetLogic": {
      "_optional": "the car's own consumption figures (l/100km, kWh/100km), logged to learn their scales",
      "currentConsumption": "rs",
      "averageConsumption": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "_optional": "the engine's fuel injection counter: the fuel used now",
      "statusInjectionVolume": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS": "*",
    "de.bmw.infotainment.controlelements.FrontCCU": {
      "_optional": "the iDrive knob tilted down switches between the trip, the song, and the song with the consumption",
      "statusRotaryEncoderState": "rs"
    },
    "de.bmw.infotainment.entertainment.mediaplayer.MediaPlayer": "*",
    "de.bmw.infotainment.hmi.hmimediastate.HmiMediaState": "*",
    "de.bmw.infotainment.entertainment.dynamicmediaplayer.DynamicMediaPlayer": "*",
    "de.bmw.infotainment.a4a.carplay.CarPlayManager": "*",
    "de.bmw.infotainment.sdi.aap.androidautoprojectedmanager.AndroidAutoProjectedManager": "*",
    "de.bmw.infrastructure.MileageSupreme": "*",
    "de.bmw.infrastructure.SecureMileage": "*",
    "de.bmw.infotainment.misc.MDrive": "*",
    "de.bmw.infrastructure.VehicleInformation": "*"
  },
